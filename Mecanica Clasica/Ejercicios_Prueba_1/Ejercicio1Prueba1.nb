          FractionBox[
           SuperscriptBox["p2", "2"], 
           SuperscriptBox["E2", "2"]]}]]}]], "==", 
      FractionBox[
       RowBox[{"mB", " ", "vRel"}], 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["vRel", "2"]}]]]}], ",", "vRel"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"p1", "->", "E1"}], ",", 
     RowBox[{"p2", "->", "E2"}]}], "}"}]}], "//", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.98703461809741*^9, 3.987034693879572*^9}},

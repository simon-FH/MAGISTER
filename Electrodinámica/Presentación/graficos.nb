Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"line", "=", 
   RowBox[{"Graphics3D", "[", 
    RowBox[{"{", 
     RowBox[{"Thick", ",", "Dashed", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "}"}], "]"}]}], "}"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"circles", "=", 
   RowBox[{"ParametricPlot3D", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Rho]", " ", 
          RowBox[{"Cos", "[", "t", "]"}]}], ",", 
         RowBox[{"\[Rho]", " ", 
          RowBox[{"Sin", "[", "t", "]"}]}], ",", "z"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Rho]", ",", "0.15", ",", "0.95", ",", "0.25"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"z", ",", 
         RowBox[{"-", "0.8"}], ",", "0.8", ",", "0.4"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
     RowBox[{"ColorFunction", "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z", ",", "t"}], "}"}], ",", 
        RowBox[{
         RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Sqrt", "[", 
             RowBox[{
              RowBox[{"x", "^", "2"}], "+", 
              RowBox[{"y", "^", "2"}]}], "]"}], "-", "0.15"}], ")"}], "/", 
          "0.80"}], "]"}]}], "]"}]}], ",", 
     RowBox[{"ColorFunctionScaling", "->", "False"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrows", "=", 
    RowBox[{"Graphics3D", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Arrowheads", "[", "0.025", "]"}], ",", "Gray", ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Arrow", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Rho]", " ", 
               RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ",", 
              RowBox[{"\[Rho]", " ", 
               RowBox[{"Sin", "[", "\[Theta]", "]"}]}], ",", "z"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[Rho]", " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"\[Theta]", "+", "0.25"}], "]"}]}], ",", 
              RowBox[{"\[Rho]", " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"\[Theta]", "+", "0.25"}], "]"}]}], ",", "z"}], 
             "}"}]}], "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Rho]", ",", "0.15", ",", "0.95", ",", "0.25"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"z", ",", 
           RowBox[{"-", "0.8"}], ",", "0.8", ",", "0.4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Theta]", ",", "0", ",", 
           RowBox[{
            RowBox[{"2", "\[Pi]"}], "-", "0.1"}], ",", 
           RowBox[{"2", 
            RowBox[{"\[Pi]", "/", "3"}]}]}], "}"}]}], "   ", 
        RowBox[{"(*", 
         RowBox[{"3", " ", "arrows", " ", "per", " ", "circle"}], "*)"}], 
        "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{"circles", ",", "arrows", ",", "line"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
